<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram id="p1" name="Quy trình hợp đồng"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1-t2" value="Quy trình hợp đồng khi đối tác gửi hợp đồng đề xuất" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F2937;html=1" vertex="1" parent="1"><mxGeometry x="40" y="4" width="900" height="36" as="geometry"/></mxCell><mxCell id="p1-lb3" value="" style="rounded=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;;html=1" vertex="1" parent="1"><mxGeometry x="40" y="102" width="300" height="1498" as="geometry"/></mxCell><mxCell id="p1-lb4" value="" style="rounded=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;;html=1" vertex="1" parent="1"><mxGeometry x="340" y="102" width="300" height="1498" as="geometry"/></mxCell><mxCell id="p1-lb5" value="" style="rounded=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;;html=1" vertex="1" parent="1"><mxGeometry x="640" y="102" width="300" height="1498" as="geometry"/></mxCell><mxCell id="p1-lb6" value="" style="rounded=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;;html=1" vertex="1" parent="1"><mxGeometry x="940" y="102" width="300" height="1498" as="geometry"/></mxCell><mxCell id="p1-lh7" value="Đối tác" style="rounded=0;whiteSpace=wrap;fillColor=#9B1C1F;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=14;;html=1" vertex="1" parent="1"><mxGeometry x="40" y="50" width="300" height="52" as="geometry"/></mxCell><mxCell id="p1-lh8" value="Sales Team (Mình)" style="rounded=0;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=#FFFFFF;fontColor=#1F2937;fontStyle=1;fontSize=14;;html=1" vertex="1" parent="1"><mxGeometry x="340" y="50" width="300" height="52" as="geometry"/></mxCell><mxCell id="p1-lh9" value="BOD (chị Hậu)" style="rounded=0;whiteSpace=wrap;fillColor=#9B1C1F;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=14;;html=1" vertex="1" parent="1"><mxGeometry x="640" y="50" width="300" height="52" as="geometry"/></mxCell><mxCell id="p1-lh10" value="BP Pháp chế (Xuân)" style="rounded=0;whiteSpace=wrap;fillColor=#9B1C1F;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=14;;html=1" vertex="1" parent="1"><mxGeometry x="940" y="50" width="300" height="52" as="geometry"/></mxCell><mxCell id="p1-n11" value="Gửi hợp đồng đề xuất&lt;br&gt;qua email" style="rounded=1;arcSize=18;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="90" y="120" width="200" height="60" as="geometry"/></mxCell><mxCell id="p1-n12" value="&lt;b&gt;1&lt;/b&gt; Nắm ý hợp đồng" style="rounded=1;arcSize=18;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="390" y="230" width="200" height="60" as="geometry"/></mxCell><mxCell id="p1-s13" value="• Business model: bán cho họ dạng nào&lt;br&gt;• Rủi ro pháp lý, thương mại&lt;br&gt;• Mail qua nên sếp không track được, mình phải tự nắm ý" style="rounded=0;whiteSpace=wrap;fillColor=#FFF3B0;strokeColor=none;fontColor=#1F2937;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;spacingRight=4;shadow=1;;html=1" vertex="1" parent="1"><mxGeometry x="375" y="300" width="230" height="88" as="geometry"/></mxCell><mxCell id="p1-n14" value="&lt;b&gt;2&lt;/b&gt; Xem offer, quyết định:&lt;br&gt;được hay không, muốn sửa gì" style="rounded=1;arcSize=18;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="690" y="440" width="200" height="60" as="geometry"/></mxCell><mxCell id="p1-n15" value="Email phản hồi theo terms của sếp,&lt;br&gt;hỏi đối tác có đồng ý không" style="rounded=1;arcSize=18;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="390" y="570" width="200" height="66" as="geometry"/></mxCell><mxCell id="p1-n16" value="Hai bên chốt hướng?" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="375" y="690" width="230" height="110" as="geometry"/></mxCell><mxCell id="p1-n17" value="Cập nhật hợp đồng&lt;br&gt;theo hướng đã chốt, gửi lại" style="rounded=1;arcSize=18;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="90" y="840" width="200" height="60" as="geometry"/></mxCell><mxCell id="p1-n18" value="&lt;b&gt;3&lt;/b&gt; Gửi email cho Legal" style="rounded=1;arcSize=18;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="390" y="960" width="200" height="60" as="geometry"/></mxCell><mxCell id="p1-s19" value="• To: Xuân (Legal)&lt;br&gt;• CC: anh Trí, chị Hậu&lt;br&gt;• Ghi rõ: bỏ qua yếu tố giá, chỉ rà terms có ổn không&lt;br&gt;• Nhờ view hợp đồng để triển khai với đối tác&lt;br&gt;• Chưa chính thức: không up lên DC" style="rounded=0;whiteSpace=wrap;fillColor=#FFF3B0;strokeColor=none;fontColor=#1F2937;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;spacingRight=4;shadow=1;;html=1" vertex="1" parent="1"><mxGeometry x="375" y="1030" width="230" height="112" as="geometry"/></mxCell><mxCell id="p1-n20" value="Kiểm tra, duyệt terms&lt;br&gt;(không xét giá)" style="rounded=1;arcSize=18;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="990" y="1180" width="200" height="60" as="geometry"/></mxCell><mxCell id="p1-n21" value="Legal duyệt?" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="975" y="1290" width="230" height="110" as="geometry"/></mxCell><mxCell id="p1-n22" value="Chưa duyệt: sửa theo Legal,&lt;br&gt;gửi lại (giả định)" style="rounded=1;arcSize=50;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="990" y="1450" width="200" height="56" as="geometry"/></mxCell><mxCell id="p1-n23" value="Ký hợp đồng" style="rounded=1;arcSize=18;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="390" y="1450" width="200" height="56" as="geometry"/></mxCell><mxCell id="p1-s24" value="• Legal duyệt rồi mới ký&lt;br&gt;• Chưa chính thức thì không up lên DC" style="rounded=0;whiteSpace=wrap;fillColor=#FFF3B0;strokeColor=none;fontColor=#1F2937;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;spacingRight=4;shadow=1;;html=1" vertex="1" parent="1"><mxGeometry x="375" y="1516" width="230" height="56" as="geometry"/></mxCell><mxCell id="p1-s25" value="• Việc kèm theo: viết lại quy trình làm hợp đồng với đối tác thành tài liệu, gắn sơ đồ onboarding vào" style="rounded=0;whiteSpace=wrap;fillColor=#FFF3B0;strokeColor=none;fontColor=#1F2937;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;spacingRight=4;shadow=1;;html=1" vertex="1" parent="1"><mxGeometry x="75" y="1450" width="230" height="72" as="geometry"/></mxCell><mxCell id="p1-e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1-n11" target="p1-n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e27" value="hỏi sếp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1-n12" target="p1-n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e28" value="terms của sếp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1-n14" target="p1-n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1-n15" target="p1-n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e30" value="chốt: yêu cầu cập nhật" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1-n16" target="p1-n17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e31" value="chưa chốt: trao đổi qua lại" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p1-n16" target="p1-n15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="625" y="745"/><mxPoint x="625" y="603"/></Array></mxGeometry></mxC