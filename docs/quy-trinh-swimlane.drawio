></diagram><diagram id="p2" name="Onboarding partner"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2-t2" value="Quy trình onboarding partner (8 bước)" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F2937;html=1" vertex="1" parent="1"><mxGeometry x="40" y="4" width="900" height="36" as="geometry"/></mxCell><mxCell id="p2-lb3" value="" style="rounded=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;;html=1" vertex="1" parent="1"><mxGeometry x="40" y="102" width="250" height="1458" as="geometry"/></mxCell><mxCell id="p2-lb4" value="" style="rounded=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;;html=1" vertex="1" parent="1"><mxGeometry x="290" y="102" width="250" height="1458" as="geometry"/></mxCell><mxCell id="p2-lb5" value="" style="rounded=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;;html=1" vertex="1" parent="1"><mxGeometry x="540" y="102" width="250" height="1458" as="geometry"/></mxCell><mxCell id="p2-lb6" value="" style="rounded=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;;html=1" vertex="1" parent="1"><mxGeometry x="790" y="102" width="250" height="1458" as="geometry"/></mxCell><mxCell id="p2-lb7" value="" style="rounded=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;;html=1" vertex="1" parent="1"><mxGeometry x="1040" y="102" width="250" height="1458" as="geometry"/></mxCell><mxCell id="p2-lb8" value="" style="rounded=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;;html=1" vertex="1" parent="1"><mxGeometry x="1290" y="102" width="250" height="1458" as="geometry"/></mxCell><mxCell id="p2-lh9" value="Đối tác" style="rounded=0;whiteSpace=wrap;fillColor=#9B1C1F;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=14;;html=1" vertex="1" parent="1"><mxGeometry x="40" y="50" width="250" height="52" as="geometry"/></mxCell><mxCell id="p2-lh10" value="Sales Team (BD)" style="rounded=0;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=#FFFFFF;fontColor=#1F2937;fontStyle=1;fontSize=14;;html=1" vertex="1" parent="1"><mxGeometry x="290" y="50" width="250" height="52" as="geometry"/></mxCell><mxCell id="p2-lh11" value="BP Kỹ thuật" style="rounded=0;whiteSpace=wrap;fillColor=#9B1C1F;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=14;;html=1" vertex="1" parent="1"><mxGeometry x="540" y="50" width="250" height="52" as="geometry"/></mxCell><mxCell id="p2-lh12" value="BP Pháp chế" style="rounded=0;whiteSpace=wrap;fillColor=#9B1C1F;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=14;;html=1" vertex="1" parent="1"><mxGeometry x="790" y="50" width="250" height="52" as="geometry"/></mxCell><mxCell id="p2-lh13" value="BOD" style="rounded=0;whiteSpace=wrap;fillColor=#9B1C1F;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=14;;html=1" vertex="1" parent="1"><mxGeometry x="1040" y="50" width="250" height="52" as="geometry"/></mxCell><mxCell id="p2-lh14" value="BP Marketing / Đào tạo" style="rounded=0;whiteSpace=wrap;fillColor=#9B1C1F;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=14;;html=1" vertex="1" parent="1"><mxGeometry x="1290" y="50" width="250" height="52" as="geometry"/></mxCell><mxCell id="p2-n15" value="&lt;b&gt;1&lt;/b&gt; Sourcing&lt;br&gt;chọn partner theo tiêu chí" style="rounded=1;arcSize=18;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="315" y="120" width="200" height="60" as="geometry"/></mxCell><mxCell id="p2-s16" value="• Tiêu chí chọn partner? (chưa chốt)&lt;br&gt;• Nguồn tìm partner? (chưa chốt)&lt;br&gt;• Đầu ra: short list &#x27;A&#x27;" style="rounded=0;whiteSpace=wrap;fillColor=#FFF3B0;strokeColor=none;fontColor=#1F2937;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;spacingRight=4;shadow=1;;html=1" vertex="1" parent="1"><mxGeometry x="65" y="120" width="200" height="72" as="geometry"/></mxCell><mxCell id="p2-n17" value="&lt;b&gt;2&lt;/b&gt; Approach&lt;br&gt;presentation công ty, VTF, proposal" style="rounded=1;arcSize=18;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="315" y="300" width="200" height="60" as="geometry"/></mxCell><mxCell id="p2-n18" value="Quan tâm,&lt;br&gt;đồng ý tìm hiểu tiếp" style="rounded=1;arcSize=18;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="75" y="410" width="180" height="60" as="geometry"/></mxCell><mxCell id="p2-n19" value="&lt;b&gt;3&lt;/b&gt; NDA&lt;br&gt;duyệt mẫu, ký hai bên" style="rounded=1;arcSize=18;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="820" y="520" width="190" height="60" as="geometry"/></mxCell><mxCell id="p2-n20" value="&lt;b&gt;4&lt;/b&gt; Gửi hồ sơ: company profile, product deck, price policy, mô hình hợp tác" style="rounded=1;arcSize=18;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="65" y="640" width="200" height="78" as="geometry"/></mxCell><mxCell id="p2-n21" value="Rà hồ sơ đủ,&lt;br&gt;sẵn sàng tech meeting" style="rounded=1;arcSize=18;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="315" y="770" width="200" height="60" as="geometry"/></mxCell><mxCell id="p2-n22" value="&lt;b&gt;5&lt;/b&gt; Tech meeting&lt;br&gt;đánh giá tiềm năng hợp tác SP" style="rounded=1;arcSize=18;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="565" y="880" width="200" height="60" as="geometry"/></mxCell><mxCell id="p2-s23" value="• Checklist: tick từng tiêu chí&lt;br&gt;• Chuẩn: SP VNW định hướng (cần viết ra)&lt;br&gt;• Tiêu chí đánh giá? (chưa chốt)" style="rounded=0;whiteSpace=wrap;fillColor=#FFF3B0;strokeColor=none;fontColor=#1F2937;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;spacingRight=4;shadow=1;;html=1" vertex="1" parent="1"><mxGeometry x="315" y="880" width="200" height="80" as="geometry"/></mxCell><mxCell id="p2-n24" value="Checklist đạt?" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="560" y="1060" width="210" height="110" as="geometry"/></mxCell><mxCell id="p2-n25" value="Không đạt: loại,&lt;br&gt;giữ trong pool (giả định)" style="rounded=1;arcSize=50;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="565" y="1210" width="200" height="56" as="geometry"/></mxCell><mxCell id="p2-n26" value="&lt;b&gt;6&lt;/b&gt; Duyệt đi tiếp&lt;br&gt;(giả định)" style="rounded=1;arcSize=18;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="1070" y="1085" width="190" height="60" as="geometry"/></mxCell><mxCell id="p2-n27" value="&lt;b&gt;7&lt;/b&gt; MOA&lt;br&gt;mô hình hợp tác, tài chính ($); soạn, rà, ký" style="rounded=1;arcSize=18;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="815" y="1300" width="200" height="78" as="geometry"/></mxCell><mxCell id="p2-s28" value="• Đối tác gửi hợp đồng? Xem trang &#x27;Quy trình hợp đồng&#x27;" style="rounded=0;whiteSpace=wrap;fillColor=#FFF3B0;strokeColor=none;fontColor=#1F2937;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;spacingRight=4;shadow=1;;html=1" vertex="1" parent="1"><mxGeometry x="565" y="1300" width="200" height="56" as="geometry"/></mxCell><mxCell id="p2-n29" value="&lt;b&gt;8&lt;/b&gt; Vận hành chung&lt;br&gt;5 hạng mục chạy song song" style="rounded=1;arcSize=18;whiteSpace=wrap;fillColor=#FFCA47;strokeColor=none;fontColor=#1F2937;fontSize=12;;html=1" vertex="1" parent="1"><mxGeometry x="1310" y="1300" width="210" height="66" as="geometry"/></mxCell><mxCell id="p2-s30" value="• Truyền thông: cập nhật hồ sơ biz VNW, A đăng&lt;br&gt;• Đóng gói VTF: theo ngành, kèm giá&lt;br&gt;• Đào tạo 2 chiều: tài liệu, VNW ⇄ tech partner&lt;br&gt;• Biz matching: ghép KH của tech partner&lt;br&gt;• Setup liên tục (nội dung chưa rõ)" style="rounded=0;whiteSpace=wrap;fillColor=#FFF3B0;strokeColor=none;fontColor=#1F2937;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;spacingRight=4;shadow=1;;html=1" vertex="1" parent="1"><mxGeometry x="1305" y="1380" width="220" height="118" as="geometry"/></mxCell><mxCell id="p2-s31" value="• Phân công bộ phận ở trang này là đề xuất, cần team xác nhận" style="rounded=0;whiteSpace=wrap;fillColor=#FFF3B0;strokeColor=none;fontColor=#1F2937;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;spacingRight=4;shadow=1;;html=1" vertex="1" parent="1"><mxGeometry x="70" y="1300" width="190" height="60" as="geometry"/></mxCell><mxCell id="p2-e32" value="short list A" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2-n15" target="p2-n17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2-n17" target="p2-n18"><